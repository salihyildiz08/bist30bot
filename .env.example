# ==============================================================================
# BIST 30 AI TRADING & PORTFOLIO ÇEVRE DEĞİŞKENLERİ
# Bu dosyayı .env olarak kopyalayıp kendi anahtarlarınızı giriniz.
# ==============================================================================

# 1. Supabase Yapılandırması (https://app.supabase.com)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# 2. Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# 3. Telegram Bildirim Botu (BotFather & userinfobot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# 4. Genel Ayarlar
MIN_RISK_REWARD_RATIO=2.0
VOLUME_SPIKE_THRESHOLD=1.3
DEFAULT_TIMEFRAME=daily
